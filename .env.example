# The Vistolane application is a separate product on its own host. This website
# never performs application work; it only routes a qualified visitor across the
# boundary with their context attached.
#
# OPN-07: both the base URL below AND the query parameter names the bridge
# appends (country, intent, program, src, and the utm_* / gclid attribution keys)
# are PROVISIONAL. They must be confirmed with the application team before
# launch. The value here is a deliberately unusable placeholder — .invalid is a
# reserved TLD that cannot resolve — so that a misconfigured deploy fails loudly
# instead of quietly sending visitors somewhere real and wrong.
NEXT_PUBLIC_PORTAL_URL=https://portal.example.invalid

# Path of the application's eligibility checker. The checker needs no account,
# which is what makes it the lowest-friction entry point we have.
NEXT_PUBLIC_PORTAL_ELIGIBILITY_PATH=/eligibility-check

# Absolute origin of this website. Canonical URLs, OpenGraph URLs, the sitemap
# and robots.txt all need it — a relative canonical is not a canonical.
# The placeholder uses the reserved .invalid TLD so a deploy that forgets to set
# this produces obviously broken canonicals rather than plausible wrong ones
# pointing at someone else's domain.
NEXT_PUBLIC_SITE_URL=https://vistolane.example.invalid
